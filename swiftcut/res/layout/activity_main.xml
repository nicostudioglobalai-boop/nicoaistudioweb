<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginLeft="20dp"
            android:text="SwiftCut"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout style="@style/Card"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">

            <TextView style="@style/CardTitle" android:text="1. PICK A VIDEO" />

            <Button
                android:id="@+id/btnPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent"
                android:text="SELECT VIDEO FROM PHONE"
                android:textColor="@color/bg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="No video selected yet. Everything you save goes to Movies/SwiftCut (audio to Music/SwiftCut)." />
        </LinearLayout>

        <LinearLayout style="@style/Card"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">

            <TextView style="@style/CardTitle" android:text="2. TRIM (no quality loss)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="START"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="END"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTrim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_accent"
                android:text="SAVE TRIMMED VIDEO"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/Card"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">

            <TextView style="@style/CardTitle" android:text="3. QUICK TOOLS" />

            <Button
                android:id="@+id/btnMute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_outline"
                android:text="MUTE VIDEO (REMOVE SOUND)"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_outline"
                android:text="EXTRACT AUDIO (SAVE SOUND)"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout style="@style/Card"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">

            <TextView style="@style/CardTitle" android:text="4. SMART EDIT AI" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Analyses the sound energy of your video and automatically keeps the loudest, best part — like a highlight cut."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHighlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_accent"
                android:text="SMART CUT — KEEP BEST PART"
                android:textColor="@color/bg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Re-encodes your video with lower quality so the file is much smaller — good before sharing on WhatsApp."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCompress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_outline"
                android:text="COMPRESS VIDEO (SMALLER FILE)"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout style="@style/Card"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">

            <TextView style="@style/CardTitle" android:text="PROGRESS" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="Ready." />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="4dp"
            android:text="Tips: Trim is instant (no re-encoding). Compress works in the background — keep the app open. All saved files stay in SwiftCut folders."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

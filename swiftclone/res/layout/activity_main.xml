<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="20dp"
        android:text="SwiftClone"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:text="Clone apps &amp; make every app respond faster — no root"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:orientation="horizontal"
        android:background="@drawable/card_bg">

        <TextView android:id="@+id/tab0"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:padding="12dp"
            android:text="@string/tab_setup" android:textColor="@color/bg"
            android:textStyle="bold" android:background="@drawable/btn_accent" />

        <TextView android:id="@+id/tab1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:padding="12dp"
            android:text="@string/tab_space" android:textColor="@color/text_secondary" />

        <TextView android:id="@+id/tab2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:padding="12dp"
            android:text="@string/tab_fast" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ViewFlipper android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 0 : Setup -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="⭐ Set up WITHOUT a computer (try this first)" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Uses Android's official work-profile wizard — no ADB, no LADB, no computer. If your phone supports it, this is all you need."
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <Button android:id="@+id/btnProvision"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="ONE-TAP SETUP (NO COMPUTER)" android:textColor="@color/bg"
                        android:background="@drawable/btn_accent" android:textAllCaps="false"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="Why some setup is needed" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Android locks real app cloning behind a device-manager permission so no random app can duplicate your apps — same restriction on iPhone. If the one-tap wizard fails on your phone, grant it once with the command below (LADB on-phone or a computer) — no root."
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="1. Enable cloning powers" />
                    <TextView android:id="@+id/ownerStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/dpmCmd"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:padding="10dp"
                        android:background="@color/bg"
                        android:fontFamily="monospace" android:textIsSelectable="true"
                        android:textColor="@color/accent_green" android:textSize="12sp" />
                    <Button android:id="@+id/btnCopyDpm"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Copy cloning command" android:textColor="@color/accent"
                        android:background="@drawable/btn_outline" android:textAllCaps="false" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Phone: Settings → About phone → tap 'Build number' 7× → Developer options → USB debugging ON. Computer: install Google's 'platform-tools', connect the USB cable, run the copied command."
                        android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="2. Animation boost (optional)" />
                    <TextView android:id="@+id/secStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:text="Speeds up menu/tap animations for every app." />
                    <TextView android:id="@+id/secCmd"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:padding="10dp"
                        android:background="@color/bg"
                        android:fontFamily="monospace" android:textIsSelectable="true"
                        android:textColor="@color/accent_green" android:textSize="12sp" />
                    <Button android:id="@+id/btnCopySec"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Copy animation command" android:textColor="@color/accent"
                        android:background="@drawable/btn_outline" android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="3. Usage access (for Fast Mode)" />
                    <TextView android:id="@+id/usageStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:text="Lets Fast Mode find apps running in the background." />
                    <Button android:id="@+id/btnUsage"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Open Usage access settings" android:textColor="@color/accent"
                        android:background="@drawable/btn_outline" android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 1 : Clone space -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="Clone space" />
                    <TextView android:id="@+id/spaceStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp">
                        <Button android:id="@+id/btnCreateSpace"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Create space" android:textColor="@color/bg"
                            android:background="@drawable/btn_accent" android:layout_marginRight="6dp"
                            android:textAllCaps="false" />
                        <Button android:id="@+id/btnOpenSpace"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Open space" android:textColor="@color/accent"
                            android:background="@drawable/btn_outline" android:layout_marginLeft="6dp"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="Pick apps to duplicate" />
                    <CheckBox android:id="@+id/showSystem"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Show system apps (advanced)" android:textColor="@color/text_secondary" />
                    <LinearLayout android:id="@+id/appList"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <Button android:id="@+id/btnClone"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="DUPLICATE SELECTED APPS" android:textColor="@color/bg"
                        android:background="@drawable/btn_accent" android:textAllCaps="false"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/cloneStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="@color/accent_green"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2 : Fast mode -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="Fast Mode" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stops Android from throttling your apps (raises their standby priority to Active), closes background processes, then reports how much RAM was freed. Run it when your phone feels sluggish."
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <Button android:id="@+id/btnFast"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="MAKE EVERYTHING FASTER" android:textColor="@color/bg"
                        android:background="@drawable/btn_accent" android:textAllCaps="false"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/fastStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="@color/accent_green"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="System animation speed" />
                    <TextView android:id="@+id/animCurrent"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="10dp">
                        <Button android:id="@+id/anim100"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="1x" android:textColor="@color/accent"
                            android:background="@drawable/btn_outline" android:layout_margin="3dp"
                            android:textAllCaps="false" />
                        <Button android:id="@+id/anim50"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="0.5x" android:textColor="@color/bg" android:layout_margin="3dp"
                            android:background="@drawable/btn_accent" android:textAllCaps="false" />
                        <Button android:id="@+id/anim25"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="0.25x" android:textColor="@color/accent"
                            android:background="@drawable/btn_outline" android:layout_margin="3dp"
                            android:textAllCaps="false" />
                        <Button android:id="@+id/anim0"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Off" android:textColor="@color/accent"
                            android:background="@drawable/btn_outline" android:layout_margin="3dp"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>
</LinearLayout>
